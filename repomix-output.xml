		:root {
			--bg-color: #0f172a;
			--card-bg: #1e293b;
			--accent-color: #38bdf8;
			--text-main: #f8fafc;
			--text-dim: #94a3b8;
		}

		body {
			margin: 0;
			padding: 0;
			font-family: 'Inter', sans-serif;
			background-color: var(--bg-color);
			color: var(--text-main);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			overflow: hidden;
		}

		.header {
			text-align: center;
			margin-bottom: 3rem;
		}

		.logo {
			font-size: 3rem;
			font-weight: 800;
			letter-spacing: -1px;
			color: var(--text-main);
			text-transform: lowercase;
		}

		.logo span {
			color: var(--accent-color);
		}

		.container {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
			max-width: 1000px;
			width: 90%;
		}

		.option-card {
			background: var(--card-bg);
			border: 2px solid transparent;
			border-radius: 1.5rem;
			padding: 2rem;
			text-align: center;
			cursor: pointer;
			transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			text-decoration: none;
			color: inherit;
			display: flex;
			flex-direction: column;
			align-items: center;
			position: relative;
		}

		.option-card:hover,
		.option-card:focus {
			transform: translateY(-10px);
			border-color: var(--accent-color);
			box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(56, 189, 248, 0.2);
			outline: none;
		}

		.option-card h2 {
			margin: 1rem 0 0.5rem 0;
			font-size: 1.25rem;
		}

		.option-card p {
			color: var(--text-dim);
			font-size: 0.9rem;
		}

		.key-hint {
			margin-top: 1.5rem;
			background: rgba(255, 255, 255, 0.1);
			padding: 0.2rem 0.8rem;
			border-radius: 0.5rem;
			font-weight: bold;
			font-size: 0.8rem;
			color: var(--accent-color);
		}

		.icon {
			width: 60px;
			height: 60px;
			fill: var(--accent-color);
		}

		@media (max-width: 768px) {
			.container {
				grid-template-columns: 1fr;
			}
		}
	</style>
</head>

