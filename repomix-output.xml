    min-width: 686px;
    margin-bottom: 10px;
    display: grid;
    grid-template-columns: minmax(150px, 1fr) 130px minmax(100px, 1fr) 130px 130px;
    gap: 0 1px;
}

.iwt-inform .linea .producto {

    border-radius: 8px 0 0 8px;
}

.iwt-inform .linea .veces {

    border-radius: 0 8px 8px 0;
}

