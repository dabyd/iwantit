    <div class="video-container">
        <video id="my-video" class="video-js iwi-player vjs-default-skin" controls preload="auto" playsinline
            webkit-playsinline poster="https://vjs.zencdn.net/v/oceans.png" data-iwi-vid="12"
            data-iwi-key="1a91b5f57348288387dd27cdb3ee497a4fda1c9a">

            <source src="https://uat.i-want-it.es/uploads/1749565299.mp4" type="video/mp4" />

            <track kind="captions"
