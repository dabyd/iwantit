:root {
     /* Palette */
    /* --palette-white-alpha40: rgba(255,255,255,0.4); */
    --palette-white: #FFFFFF;
    --palette-big-stone: #142842;
    --palette-black: #000;
    --palette-dark-tan: #750F14;
    --palette-denim: #147BD1; /* Corporate */
    --palette-indochine: #CF7F00; /* Corporate */
    --palette-gray: #888888;
    --palette-gray-chateau: #989EA3;
    --palette-loblolly: #C8CFD4;
    --palette-biscay: #1B365D; /* Corporate */
    --palette-biscay-translucent: rgba(27,54,93,0.8);
    --palette-biscay-10-translucent: rgba(27,54,93,0.1);
    --palette-nile-blue: #1A3356;
    --palette-parsley: #196C21;
    --palette-regal-blue: #054A75;
    --palette-timberwolf: #D7D2CB; /* Corporate */
    --palette-wild-sand: #F6F6F6;
    --palette-wild-sand-translucent: rgba(246,246,246,90%);

     /* Dark mode */
    --color-scheme: dark;
    --color-font: var( --palette-timberwolf);
    --color-background: var(--palette-biscay);
    --color-background-translucent: var(--palette-biscay-translucent);
    --color-link-hover-default: var(--palette-indochine);

       /* Native bar */
    --color-bar-native-scroll-bar: var(--color-font);
    --color-track-native-scroll-bar: var(--color-background);

    /* Background */
    /* --background-video-filter: none; */


      /* Dark mode switcher */
    /* --color-dark-mode-switcher-background: var(--palette-white);
    --color-dark-mode-switcher-dark: var(--palette-biscay);
    --position-dark-mode-switcher-selection: 2px; */

    /*  Container admin. */
    --color-background-admin: var(--palette-nile-blue);
    --color-border-admin: var(--palette-big-stone);

    /* Menu */
    --color-background-menu: var(--palette-denim);

    /* Menu options */
    --color-option-text: var(--palette-timberwolf);
    --color-option-background-active: var(--palette-timberwolf);
    --color-option-text-active: var(--palette-biscay);
    --color-option-background-hover: var(--palette-indochine);
    --color-option-text-hover: var(--palette-timberwolf);
    --color-option-text-disabled: var(--palette-biscay);

    /* Table */
    --color-table-border: var(--palette-nile-blue);
    --color-table-header-background: var(--palette-denim);
    --color-table-cell-background: var(--palette-biscay);
    --color-table-actions-cell-background: var(--palette-biscay);

    /* Button */

    --color-button-default-background: var(--palette-denim);
    --color-button-default-text: var(--palette-timberwolf);
    --color-button-default-hover-text: var(--palette-white);
    --color-button-danger-background: var(--palette-dark-tan);
    --color-button-warning-background: var(--palette-indochine);
    --color-button-success-background: var(--palette-denim);
    --color-buton-enabled-background: var(--palette-parsley);
    --color-buton-disabled-background: var(--palette-dark-tan);

    /*  Label */
    --color-label-enabled-background: var(--palette-parsley);
    --color-label-disabled-background: var(--palette-dark-tan);

    /*  Input and select */
    --color-input-placeholder: var(--palette-denim);
    --color-input-select-border: var(--palette-biscay);
    --color-input-select-background: var(--palette-big-stone);
    --color-select-option-checked: var(--palette-indochine);

    /* Spinner */
    --color-spinner-background: var(--palette-biscay-translucent);
    --color-spinner: var(--palette-indochine);

    /* Login */
    /* --color-login-sign-up: var(--palette-denim); */

    /* Default color for the :focus event in browser ui components */
    /* --color-iu-focus-default: var(--palette-indochine); */

    /* input */
    /* --color-input-background: var( --palette-timberwolf);
