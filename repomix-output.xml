<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IWI Video.js Player 1.0.0 - Full View Port</title>

    <link href="iwi-player.css" rel="stylesheet" />
    <script src="iwi-player.js" defer></script>

    <style>
        body {
            font-family: sans-serif;
            background-color: #000;
            color: white;
            margin: 0;
            padding: 0;
            height: 100vh;
            height: 100dvh;
            /* Mejor soporte para móviles (barra de navegación dinámica) */
