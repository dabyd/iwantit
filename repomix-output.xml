			--accent-color: #38bdf8;
			--text-main: #f8fafc;
			--text-dim: #94a3b8;
		}

		body {
			margin: 0;
			padding: 0;
			font-family: 'Inter', sans-serif;
			background-color: var(--bg-color);
			color: var(--text-main);
			display: flex;
